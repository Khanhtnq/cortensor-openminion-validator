# Cortensor Sentinel — Provider & Runtime Configuration

# Default $0 local model mode (Ollama):
OLLAMA_HOST=http://127.0.0.1:11434
SENTINEL_PROVIDER=ollama
SENTINEL_MODEL=qwen2.5:7b-instruct

# Optional Cortensor Portal (OpenAI-compatible chat completions mode):
# SENTINEL_PROVIDER=cortensor
# CORTENSOR_API_MODE=openai_chat
# CORTENSOR_API_URL=https://api.cortensor.app/v1
# CORTENSOR_API_KEY=your_portal_api_key_here
# SENTINEL_MODEL=oss-20b

# Optional Cortensor Local/Remote Router (/api/v2/completions session mode):
# SENTINEL_PROVIDER=cortensor
# CORTENSOR_API_MODE=cortensor_completion
# CORTENSOR_API_URL=http://127.0.0.1:8080/api/v2/completions
# CORTENSOR_API_KEY=your_router_token_if_enabled
# CORTENSOR_SESSION_ID=1
# CORTENSOR_SESSION_IDS=1,2
# SENTINEL_MODEL=gpt-oss-20b
